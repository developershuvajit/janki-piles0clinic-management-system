# MedClinic — Apache Configuration
# Phase 35: Performance + Phase 39: Security Headers

Options -Indexes -MultiViews

# ---------------------------------------------------------------
# URL REWRITING
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing files/directories directly
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f

    # Route everything else through index.php
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# ---------------------------------------------------------------
# GZIP COMPRESSION
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml text/xml
    AddOutputFilterByType DEFLATE font/woff2 font/woff application/font-woff
</IfModule>

# ---------------------------------------------------------------
# BROWSER CACHING
# ---------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — no cache (dynamic content)
    ExpiresByType text/html                     "access plus 0 seconds"

    # CSS / JS — 1 month
    ExpiresByType text/css                      "access plus 1 month"
    ExpiresByType application/javascript        "access plus 1 month"

    # Fonts — 1 year
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType font/woff                     "access plus 1 year"
    ExpiresByType application/font-woff         "access plus 1 year"

    # Images — 1 week
    ExpiresByType image/jpeg                    "access plus 1 week"
    ExpiresByType image/png                     "access plus 1 week"
    ExpiresByType image/gif                     "access plus 1 week"
    ExpiresByType image/webp                    "access plus 1 week"
    ExpiresByType image/svg+xml                 "access plus 1 week"
    ExpiresByType image/x-icon                  "access plus 1 month"

    # Default fallback
    ExpiresDefault                              "access plus 1 week"
</IfModule>

# ---------------------------------------------------------------
# SECURITY HEADERS
# ---------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"

    # XSS protection for legacy browsers
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Remove Server signature
    Header unset Server
    Header always unset X-Powered-By

    # Prevent caching of sensitive admin pages
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>

    # Allow long-term caching for versioned assets
    <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------
# HTTPS REDIRECT (enable in production)
# ---------------------------------------------------------------
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTPS} off
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---------------------------------------------------------------
# BLOCK DIRECT PHP ACCESS TO SENSITIVE DIRS
# ---------------------------------------------------------------
<FilesMatch "^(\.env|composer\.(json|lock)|config\.php)">
    Require all denied
</FilesMatch>

# Block access to hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
