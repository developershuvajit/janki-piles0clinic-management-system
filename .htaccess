Options -Indexes -MultiViews

# ---------------------------------------------------------------
# BLOCK SENSITIVE FILES
# The application root is web-served, so dotfiles, dumps, logs and
# developer scripts must never be reachable over HTTP.
# ---------------------------------------------------------------
<FilesMatch "(^\.|\.(env|log|sql|zip|md|json|lock|ini|bak|sh)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^test_.*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteBase /2026/clinic/

    # Never serve the contents of internal directories directly
    RewriteRule ^(app|config|database|docs|logs|storage|vendor)(/|$) - [F,L]

    # Existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send application routes to root index.php
    RewriteRule ^(.+)$ index.php [L,QSA]
</IfModule>
