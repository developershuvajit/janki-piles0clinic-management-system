 Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /2026/clinic/

    # Agar URL mein public hai toh hata do
    RewriteRule ^public/(.*)$ $1 [R=301,L]

    # Agar koi file/directory exist karti hai toh serve karo
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Baaki sab public/index.php pe bhejo
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>